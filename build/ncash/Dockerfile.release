FROM alpine:3.16
LABEL org.opencontainers.image.source="https://github.com/ohstr/ncash"

COPY ncash /bin/ncash

# State (identity.json/connections.json/ledger.json) defaults to
# $XDG_CONFIG_HOME/ncash — mount a volume there to persist it across
# container restarts, e.g. `-v ncash-data:/root/.config/ncash`.
WORKDIR /root

ENTRYPOINT ["/bin/ncash"]
