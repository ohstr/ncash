FROM alpine:3.16
LABEL org.opencontainers.image.source="https://github.com/ohstr/cashctl"

COPY cashctl /bin/cashctl

# State (identity.json/connections.json/ledger.json) defaults to
# $XDG_CONFIG_HOME/cashctl — mount a volume there to persist it across
# container restarts, e.g. `-v cashctl-data:/root/.config/cashctl`.
WORKDIR /root

ENTRYPOINT ["/bin/cashctl"]
