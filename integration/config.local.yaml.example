# Copy this file to config.local.yaml (gitignored) and point it at a real,
# already-running lokihub instance's admin API. See README.md — every
# cash_hub/circle_hub fixture a test needs is provisioned on demand through
# this API (see admin_client.go), so there's nothing else to hand-provision
# here.

# Mint a token via POST {base_url}/api/unlock (permission: "full", an
# explicit token_expiry_days — it defaults to 30) and paste it below.
admin_api:
  base_url: "http://localhost:5610"
  token: ""
